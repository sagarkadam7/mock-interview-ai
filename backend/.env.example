PORT=5001
# Optional: shown on GET /api/health for deploy/version dashboards
# APP_VERSION=1.0.0

MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/mockinterview
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars

# Auth session cookie (httpOnly). In production, deploy behind HTTPS and keep SESSION_COOKIE_SECURE=true.
# AUTH_COOKIE_NAME=token
# SESSION_COOKIE_SECURE=true
# AUTH_TOKEN_IN_BODY=true

GEMINI_API_KEY=
# Optional: comma-separated keys rotated on quota errors (different Google accounts work best)
# GEMINI_API_KEYS=key_one,key_two,key_three
# Primary model (default: gemini-2.0-flash-lite — better free-tier headroom than flash)
# GEMINI_MODEL=gemini-2.0-flash-lite
# Optional comma-separated fallbacks tried automatically on quota errors:
# GEMINI_MODEL_FALLBACKS=gemini-2.0-flash-lite,gemini-1.5-flash

# ── Free Groq fallback (recommended when Gemini quota hits) ─────────────────
# Get a free key at https://console.groq.com — no credit card required.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# AI_PROVIDER=auto
#   auto   = try Gemini first, fall back to Groq on quota errors (default)
#   gemini = Gemini only
#   groq   = Groq only (fast, generous free tier)

# Comma-separated origins for browser CORS (production + local).
# Local: http://localhost:3000
# Render static site: https://your-site-name.onrender.com (add both preview + prod if needed)
FRONTEND_ORIGINS=http://localhost:3000

# Required when the React app is on a different origin than this API (e.g. two Render services).
# Sends JWT in JSON on login/register so the SPA can store it; httpOnly cookies are not sent cross-site.
# AUTH_TOKEN_IN_BODY=true

# Optional: tune rate limits (defaults are safe for dev)
# AUTH_RATE_LIMIT_MAX=40
# API_RATE_LIMIT_MAX=500
# CREATE_INTERVIEW_RATE_LIMIT_MAX=30
# PREP_BRIEF_RATE_LIMIT_MAX=20

# Security hardening toggles
# NODE_ENV=production
